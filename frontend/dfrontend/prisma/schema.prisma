// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String    @unique
  role      Role      @default(AUDITOR)
  password  String
  pdfs      PDF[]
  reviews   PDF[]     @relation("ReviewedPDFs") // ✅ PDFs assigned to them for review
  flags     Flag[]

  flagReviews     FlagReview[]
  documentReviews DocumentReview[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  lastLogin DateTime?
  isActive  Boolean   @default(false)
}

model PDF {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  reviewer   User?   @relation("ReviewedPDFs", fields: [reviewerId], references: [id])
  reviewerId String? // Nullable: unassigned by default

  text            String
  inconsistencies String
  rag_analysis    String
  recommendations String
  enhanced        String
  error           String
  summary         String
  filename        String
  status          Status
  uploadedAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastFlagged     DateTime? // When this PDF was last flagged
  commentCount    Int       @default(0) // Count of comments (FLAG type)
  flagCount       Int       @default(0) // Count of flags (COMMENT, QUESTION, CRITICAL types)
  pdfURL          String    @default("")
  // Relations

  reviewText       String?   // Or use Json? for structured reviews
  reviewedAt       DateTime?

  flags           Flag[]
  documentReviews DocumentReview[]

  // Indexes
  @@index([userId])
  @@index([status])
  @@index([uploadedAt])
  @@index([lastFlagged])
  @@index([commentCount])
  @@index([flagCount])
}

model Flag {
  id         String     @id @default(uuid())
  // Relations
  pdf        PDF        @relation(fields: [pdfId], references: [id], onDelete: Cascade)
  pdfId      String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // Flag content
  text       String // The selected text that was flagged
  comment    String // User's comment/note about the flag
  reviewComment String? 
  type       FlagType // Whether it's a flag or comment
  section    String // Which section of the document (originalData, analysis, etc.)
  // Position tracking
  startIndex Int // Start position of the flagged text
  endIndex   Int // End position of the flagged text
  // Status and metadata
  status     FlagStatus @default(ACTIVE)
  priority   Priority   @default(MEDIUM)
  // Timestamps
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  resolvedAt DateTime?
  resolvedBy String? // User ID who resolved the flag

  flagReviews FlagReview[]

  // Indexes for performance
  @@index([pdfId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([section])
  @@index([createdAt])
}

model FlagReview {
  id         String   @id @default(uuid())
  flag       Flag     @relation(fields: [flagId], references: [id], onDelete: Cascade)
  flagId     String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String
  
  status     FlagReviewStatus
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([flagId])
  @@index([reviewerId])
  @@index([createdAt])
}

model DocumentReview {
  id         String   @id @default(uuid())
  pdf        PDF      @relation(fields: [pdfId], references: [id], onDelete: Cascade)
  pdfId      String
  reviewer   User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String
  
  status     DocumentReviewStatus
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([pdfId, reviewerId]) // One review per PDF per reviewer
  @@index([pdfId])
  @@index([reviewerId])
  @@index([createdAt])
}


enum Status {
  VERIFIED
  PENDING
  FAILED
}

enum FlagType {
  FLAG // Issues/problems
  COMMENT // General comments/notes
  QUESTION // Questions that need answers
  CRITICAL // Critical issues requiring immediate attention
}

enum FlagStatus {
  ACTIVE // Flag is active and needs attention
  RESOLVED // Flag has been addressed
  DISMISSED // Flag was dismissed as not relevant
  IN_REVIEW // Flag is being reviewed
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Role {
  AUDITOR
  REVIEWER
  ADMIN
}


enum FlagReviewStatus {
  APPROVED
  REJECTED
  NEEDS_CLARIFICATION
}

enum DocumentReviewStatus {
  APPROVED
  REJECTED
  NEEDS_REVISION
}